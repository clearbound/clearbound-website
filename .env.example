# Copy this to .env.local for local development (vercel dev reads it automatically).
# In production/preview, set these with `vercel env add <NAME>` instead of committing
# real values anywhere.

# Supabase — service role key, server-side only. Never expose this to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend — transactional email. LEAD_ALERT_EMAIL is used both as the internal
# notification recipient and as the "from" address on the auto-reply, so it must
# be a mailbox on a domain you've verified in Resend.
RESEND_API_KEY=
LEAD_ALERT_EMAIL=

# Optional — if both are set, a Pushover push notification is sent on each new
# lead. If either is missing, push notifications are silently skipped.
PUSHOVER_USER_KEY=
PUSHOVER_APP_TOKEN=

# Optional — if set, the auto-reply includes a "book a time" line linking here.
BOOKING_URL=
